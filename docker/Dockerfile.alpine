# Alpine/musl build environment for `lo`, matching the toolchain proven
# out in this sandbox's own musl bring-up - see ../LO-MUSL.md (in the
# claude-cloned-repo docs, not this repo) for the full story of what
# each of these packages is for and what broke without them.
#
# This image only sets up the *environment* - it does not COPY in
# source or build `lo` itself. Mount the checked-out repo in and run
# make against it, so build artifacts land directly in your working
# tree, not buried inside a container layer:
#
#   docker build -t lo-musl -f docker/Dockerfile.alpine .
#   docker run --rm -v "$(pwd):/src" -w /src lo-musl make lo
#   docker run --rm -v "$(pwd):/src" -w /src lo-musl make check
#
# Wired up for real in .github/workflows/push.yml as the `build-linux-musl`
# job (same pattern as the local commands above: build the image once,
# reuse it for both the compile and check steps against the checked-out
# workspace, upload the resulting `lo` as an artifact). `make check-build`
# (./lo test/build.js, ~19 more bindings beyond this build's five) is now
# enabled here too (was deferred - every per-module build.js touched so
# far during this musl bring-up needed some sysroot-shaped fix, so more
# were expected; see LO-MUSL.md / PLAN.md task 34). First real failure
# hitting this: mbedtls's own vendored build shells out to
# scripts/generate_driver_wrappers.py, which imports jsonschema and
# jinja2 - the exact same gap Dockerfile.ubuntu already hit and fixed
# (see its own comment there) for the identical mbedtls step, just not
# yet ported to this image. One real CI failure at a time, same
# discipline as Dockerfile.ubuntu's own history - more gaps of this
# shape are plausible as the sweep goes further, not something to
# pre-guess a full list for.
#
# Confirmed working end to end on a real Ubuntu host (`docker build` +
# the mounted-volume `make lo`/`make check` pattern above), including a
# real gap the reasoning below missed on the first pass (`linux-headers`,
# fixed - see LO-MUSL.md for the story). Package list is grounded in this
# session's own real, verified musl build (LO-MUSL.md) plus the actual
# apk dependency metadata for the trickier ones (lld21, libstdc++,
# libgcc - checked directly against the real APKINDEX, not guessed: none
# of them need anything beyond what's listed below, real `apk` resolves
# their transitive deps - lld21-libs/scudo-malloc/llvm21-libs/libcurl/
# etc. - automatically, unlike this sandbox's own alpine-pkg.sh, which
# has a documented gap there, see LO-APK.md).

FROM alpine:3.23

RUN apk add --no-cache \
    make binutils \
    musl-dev linux-headers \
    libstdc++-dev \
    clang21 \
    lld21 \
    curl curl-dev \
    openssl-dev \
    zlib-dev \
    python3 py3-pip

# mbedtls's generate_driver_wrappers.py needs these - see the comment
# above. --break-system-packages: Alpine's python3 (3.12, PEP 668) marks
# itself externally-managed, refusing a bare `pip install` outside a
# venv - fine here, this container's only purpose is this build.
RUN pip3 install --no-cache-dir --break-system-packages jsonschema jinja2

# MUSL=1 and MUSL_SYSROOT=/ so `make`/`make check` work here with no
# extra flags - see the top-level Makefile and LO-MUSL.md for what these
# gate. MUSL_SYSROOT points at this sandbox's own nonstandard chroot
# path by default (/root/demo/alpine-toolchain/root) since the Makefile
# was written for a toolchain living somewhere other than the real
# system paths; in a native Alpine container like this one, headers/libs
# already live at the normal /usr/include, /usr/lib locations, so the
# real filesystem root is the correct sysroot value - confirmed working
# end to end (a full `make clean lo` build, --sysroot=/ on every compile
# and link line, no errors) rather than just reasoned through.
ENV MUSL=1
ENV MUSL_SYSROOT=/

WORKDIR /src
